<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.Riverlake</groupId>
    <artifactId>RiverlakeTest</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>WebTestEureka-1</name>
    <description>this is project just api demo</description>
    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.0</spring-cloud.version>
    </properties>
    <dependencies>
        <!-- Add your dependencies here -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Other dependencies -->
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version> <!-- Use the appropriate version -->
                <configuration>
                    <!-- Configure Surefire Plugin settings -->
                    <forkCount>1</forkCount> <!-- Set forkCount to 1 for better isolation -->
                    <reuseForks>false</reuseForks> <!-- Disable fork reuse -->
                    <testFailureIgnore>false</testFailureIgnore> <!-- Do not ignore test failures -->
                    <!-- Other configurations as needed -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
